{
  "name": "@breadc/monorepo",
  "version": "1.0.0-beta.23",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "docs:build": "turbo run build --filter=@breadc/docs",
    "docs:deploy": "turbo run deploy --filter=@breadc/docs",
    "docs:dev": "turbo run dev --filter=@breadc/docs",
    "docs:preview": "turbo run preview --filter=@breadc/docs",
    "format": "prettier --write '**/*.{ts,tsx,js,mjs}'",
    "release": "bumpp package.json packages/*/package.json apps/*/package.json --commit --push --tag",
    "test:ci": "turbo run test:ci",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "preversion": "turbo run test:ci"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "bumpp": "latest",
    "cac": "^7.1.0",
    "commander": "^15.0.0",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.3",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.16.1"
}
